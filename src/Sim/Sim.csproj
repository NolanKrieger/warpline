<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure C# simulation: no Godot types, so it builds, tests and replays headless and deterministically. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Warpline.Sim</RootNamespace>
    <AssemblyName>Warpline.Sim</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
